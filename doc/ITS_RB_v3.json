[
  { "match": ".*", "rigidBody": "fixed" },

  { "match": "PVT/meanVertex", "calib": { "type": "meanvertex", "free": ["X", "Y", "Z"] } },
  { "match": "PVT/meanVertex", "measurement": { "X": [0.0, 0.005], "Y": [0.0, 0.005], "Z": [0.0, 0.1] } },

  { "match": "ITS", "rigidBody": "fixed",
    "pinChildrenMeanNoCross": ["TX", "TY", "TZ", "RZ"] },

  { "match": "ITS/ITSULayer[0-2]/ITSUHalfBarrel[0-1]", "rigidBody": ["TX", "TY", "TZ", "RZ"] },
  { "match": "ITS/ITSULayer[0-2]/ITSUHalfBarrel[0-1]", "measurement": { "TX": [0.0, 0.003], "TY": [0.0, 0.003], "TZ": [0.0, 0.003] } },

  { "match": "ITS/ITSULayer[3-6]/ITSUHalfBarrel[0-1]", "rigidBody": "fixed",
    "pinChildrenMeanNoCross": ["TX", "TY", "TZ", "RY"] },

  { "match": "ITS/ITSULayer[0-2]/ITSUHalfBarrel[0-1]/ITSUStave[0-9]+", "rigidBody": ["TX", "TY", "TZ", "RY"] },

  { "match": "ITS/ITSULayer[0-2]/ITSUHalfBarrel[0-1]/ITSUStave[0-9]+/ITSUChip[0-9]+", "rigidBody": ["TX", "TY", "TZ", "RY"] },
  { "match": "ITS/ITSULayer[0-2]/ITSUHalfBarrel[0-1]/ITSUStave[0-9]+/ITSUChip[0-9]+", "measurement": { "TY": [0.0, 0.0005] } },

  { "match": "ITS/ITSULayer[3-6]/ITSUHalfBarrel[0-1]/ITSUStave[0-9]+", "rigidBody": ["TX", "TY", "TZ", "RY"] },

  { "match": "ITS/ITSULayer[3-6]/ITSUHalfBarrel[0-1]/ITSUStave[0-9]+/ITSUHalfStave[0-9]+", "rigidBody": ["TX", "TY", "TZ", "RY"] },

  { "match": "ITS/ITSULayer[3-6]/ITSUHalfBarrel[0-1]/ITSUStave[0-9]+/ITSUHalfStave[0-9]+/ITSUModule[0-9]+", "rigidBody": ["TX", "TY", "TZ", "RY"] },
  { "match": "ITS/ITSULayer[3-6]/ITSUHalfBarrel[0-1]/ITSUStave[0-9]+/ITSUHalfStave[0-9]+/ITSUModule[0-9]+", "measurement": { "TY": [0.0, 0.003] } },

  { "match": "ITS/.+",
    "globalModes": ["radialScaling", "zScaling", "curl", "twist", "globalTilt",
                    "radialHarmonic", "tangentialHarmonic",
                    "radialPolar", "tangentialPolar", "longitudinalPolar"] }
]
